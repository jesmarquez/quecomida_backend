# Database (Postgres). If you don't have Postgres set up locally, use a free hosted one
# from Neon, Supabase, or Railway and paste the connection string here.
DATABASE_URL="postgresql://user:password@localhost:5432/food_marketplace?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=4000

# Email (used to send order verification codes)
# For local dev, create a free inbox at https://ethereal.email and paste the creds below.
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-ethereal-user"
SMTP_PASS="your-ethereal-pass"
SMTP_FROM="Food Marketplace <no-reply@foodmarketplace.dev>"
